{
  "ConnectionStrings": {
    // No real values here — connection details come from the environment
    // (compose sets ConnectionStrings__DefaultConnection) or, for local dev,
    // from appsettings.Development.json / user-secrets. See README.
    "DefaultConnection": ""
  },
  "GradingService": {
    "BaseUrl": "http://localhost:5001",
    "InternalKey": ""
  },
  "Jwt": {
    // No default key — Program.cs FAILS STARTUP when Jwt:SigningKey is empty
    // or matches the known dev literal while running in Production.
    // Local development supplies it via user-secrets or appsettings.Development.json.
    "SigningKey": "",
    "Issuer": "econgrader",
    "Audience": "econgrader-api",
    "TtlMinutes": 480,
    // One-shot first-admin bootstrap key; empty disables bootstrap entirely.
    "BootstrapAdminKey": ""
  },
  "FileStorage": {
    "RootPath": "storage/images"
  },
  "Cors": {
    "AllowedOrigins": "*"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      { "Name": "File",
        "Args": {
          "path": "logs/econ-grader-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
