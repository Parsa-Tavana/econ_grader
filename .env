# Used by docker-compose.yml to inject secrets into containers.
# Fill in your real key(s); unused providers can stay empty.
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=

# JWT signing key for the API (generate: openssl rand -base64 48).
# Tokens are rejected unless signed with exactly this key.
JWT_SIGNING_KEY=0Jmw45NuQ2s/r3ir1nigCWHqy8Ta9utEtuxWo0QjQTgmNLlB1t6Vu3G1BkRAB/3j
# One-shot key to create the FIRST admin via POST /api/auth/bootstrap-admin.
# Leave empty = bootstrap disabled (recommended once an admin exists).
JWT_BOOTSTRAP_ADMIN_KEY=b25d7f5a9c4ec0b7f9dde997b8fad4fe

# added for 2B hardening
SA_PASSWORD=PHkvHfPPXgAUOBCygmQRYU8S!Aa1
