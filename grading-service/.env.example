# Copy to .env and fill in your keys — NEVER commit .env
MODEL_PROVIDER=claude
MODEL_NAME=claude-3-5-sonnet-20241022
MODEL_VERSION=

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_API_KEY=not-needed
# Authorization header prefix for the QWEN_BASE_URL endpoint:
#   Bearer (default, most OpenAI-compatible gateways) | apikey (GLM platform)
QWEN_AUTH_SCHEME=Bearer

# Fourth slot (GPT) — same OpenAI-compatible gateway pattern as QWEN_*.
GPT_BASE_URL=
GPT_API_KEY=not-needed
GPT_MODEL=gpt-5.6-sol
GPT_AUTH_SCHEME=apikey

DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=2048

IMAGE_STORAGE_ROOT=storage/images
PROMPTS_DIR=app/prompts

LOG_LEVEL=INFO