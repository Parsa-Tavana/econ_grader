# Copy to .env and fill in your keys — NEVER commit .env
# Provider selection — glm (default) | gpt. Users cannot choose per run.
MODEL_PROVIDER=glm
MODEL_NAME=GLM-5.3
MODEL_VERSION=

# First slot — GLM platform endpoint (default provider).
#   BASE_URL: the platform endpoint WITHOUT the trailing /chat/completions
#   API_KEY:  the access key / machine-user key for that endpoint
#   AUTH_SCHEME: Bearer | apikey (the GLM platform uses "apikey", NOT Bearer)
GLM_BASE_URL=
GLM_API_KEY=not-needed
GLM_MODEL=GLM-5.3
GLM_AUTH_SCHEME=apikey

# Second slot — GPT-5.6-Sol, same gateway pattern as GLM_*, reserved for
# future use (MODEL_PROVIDER=gpt activates it).
GPT_BASE_URL=
GPT_API_KEY=not-needed
GPT_MODEL=GPT-5.6-Sol
GPT_AUTH_SCHEME=apikey

DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=2048

IMAGE_STORAGE_ROOT=storage/images
PROMPTS_DIR=app/prompts

LOG_LEVEL=INFO