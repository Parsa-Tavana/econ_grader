# ═══════════════════════════════════════════════════════════════════════════
# EconGrader — root environment for `docker compose`.
#
# Setup:  cp .env.example .env   then fill every value below.
# NEVER commit .env (gitignored). Generate secrets with:
#     openssl rand -base64 48
# ═══════════════════════════════════════════════════════════════════════════

# ── SQL Server ────────────────────────────────────────────────────────────────
# sa password (admin/maintenance only; the app uses DB_APP_PASSWORD).
# SQL requires: 8+ chars with upper, lower, digit, symbol.
SA_PASSWORD=CHANGE_ME_openssl-rand-base64-32

# App login created by scripts/init-db.sql — rights ONLY in the EconGrader db.
DB_APP_PASSWORD=CHANGE_ME_openssl-rand-base64-32

# ── JWT auth (.NET api) ───────────────────────────────────────────────────────
# Token signing key. Production REFUSES to boot if empty or equal to the dev
# default. openssl rand -base64 48
JWT_SIGNING_KEY=
# One-shot key for creating the first admin on the login page. Empty disables
# the bootstrap endpoint entirely. Any random hex string works:
#     openssl rand -hex 16
JWT_BOOTSTRAP_ADMIN_KEY=

# ── Internal service-to-service auth (api ⇄ grading) ─────────────────────────
# Shared secret sent as X-Internal-Key by the .NET api on every grading call.
# MUST match on both services. In production an empty value makes the grading
# service reject all protected requests (fail-closed). Local bare-metal dev
# WITHOUT compose needs no key at all (dev bypass in app/internal_auth.py).
#     openssl rand -hex 32
GRADING_INTERNAL_KEY=

# ── AI provider keys (grading service) ───────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Public site (caddy proxy) ─────────────────────────────────────────────────
# ":80"                → local HTTP testing (curl http://localhost/...)
# "grader.example.dev" → automatic HTTPS via Let's Encrypt (.dev is
#                        HSTS-preloaded; HTTPS is mandatory there)
SITE_ADDRESS=:80
# Let's Encrypt account email (expiry notices). Optional but recommended in prod.
ACME_EMAIL=
