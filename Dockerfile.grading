FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /srv

# Java-free PDF rendering needs poppler (pdf2image dependency)
RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY pricing.json ./

# Non-root user. /srv/storage is the SHARED answer-image volume (mounted by
# compose); pre-own it so writes succeed when the volume is first seeded.
RUN useradd --create-home appuser && chown -R appuser /srv && mkdir -p /srv/storage/images && chown -R appuser /srv/storage
USER appuser

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD curl -fsS http://localhost:5001/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5001"]
